# Outcome Ledger API (standalone — not Authon)

DATABASE_URL=sqlite:///./outcome_ledger.db
OUTCOME_LEDGER_API_KEY=change-me-in-production
# Multi-tenant: Clerk (recommended) — see docs/clerk-setup.md
# CLERK_SECRET_KEY=sk_test_...
# CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=http://localhost:3001
# Legacy ol_* keys: TENANT_REGISTRATION_ENABLED=true, TENANT_KEY_PEPPER=...
# Railway sets RAILWAY_ENVIRONMENT=production — API then requires API key + non-* CORS
ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# OpenAI billing (docs/openai-setup.md) — service account needs OPENAI_PROJECT_ID
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Anthropic Admin API (sk-ant-admin...) — Cost Report
ANTHROPIC_ADMIN_API_KEY=

# Langfuse (optional) — trace metadata for learned linker features
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# GitHub — classic PAT with repo read (fallback)
GITHUB_TOKEN=
GITHUB_REPOS=org/repo-one,org/repo-two

# GitHub App (recommended — webhooks, Weave-style install)
GITHUB_APP_ID=
GITHUB_APP_SLUG=outcome-ledger
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SETUP_URL=https://outcome-ledger-production.up.railway.app/v1/connect/github-app/callback

# GitHub OAuth (fallback — Connect with GitHub button)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://outcome-ledger-production.up.railway.app/v1/connect/github/callback
PUBLIC_API_URL=https://outcome-ledger-production.up.railway.app
DASHBOARD_URL=https://outcome-ledger-dashboard-production.up.railway.app

# Sync window on POST /v1/sync
SYNC_LOOKBACK_DAYS=90

# Enterprise (Phase A)
OUTCOME_STABLE_DAYS=7
CPST_METRIC_VERSION=1.0
CRON_SECRET=
# Cron: POST /v1/cron/sync-all (daily), POST /v1/cron/weekly-digest (Mondays)
# See docs/notifications-setup.md

# Executive report (optional LLM — falls back to deterministic template)
EXECUTIVE_REPORT_MODEL=gpt-4.1-mini

# Waitlist landing (/join) — public signup + page views
WAITLIST_CAP=50

# Email (Resend) — notifies you on each new waitlist signup
# Setup guide: docs/resend-setup.md

# Test without a domain: onboarding@resend.dev (only delivers to your Resend account email)
WAITLIST_FROM_EMAIL=onboarding@resend.dev
WAITLIST_NOTIFY_EMAILS=you@company.com
LANDING_URL=https://outcome-ledger-landing-production.up.railway.app
# Auto-reply to signups — true only after your domain is verified in Resend
WAITLIST_WELCOME_EMAIL=false

# Organization header on PDF board pack (optional — prefer Settings UI)
ORGANIZATION_NAME=
ORGANIZATION_LEGAL_NAME=
ORGANIZATION_TAGLINE=
ORGANIZATION_STAGE=
ORGANIZATION_INDUSTRY=
ORGANIZATION_WEBSITE=
ORGANIZATION_HEADQUARTERS=

# Local MCP agent (mcp/) — vendor keys stay on customer machines; uses ol_* + POST /v1/ingest/*
# See docs/mcp-setup.md
