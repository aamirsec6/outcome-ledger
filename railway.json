{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "outcome-ledger": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "api/Dockerfile",
        "watchPatterns": ["api/**"]
      },
      "deploy": {
        "healthcheckPath": "/health",
        "healthcheckTimeout": 120,
        "restartPolicyType": "ON_FAILURE"
      }
    },
    "outcome-ledger-dashboard": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "dashboard/Dockerfile",
        "watchPatterns": ["dashboard/**"]
      },
      "deploy": {
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 120,
        "restartPolicyType": "ON_FAILURE"
      }
    },
    "outcome-ledger-landing": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "landing/Dockerfile",
        "watchPatterns": ["landing/**"]
      },
      "deploy": {
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 120,
        "restartPolicyType": "ON_FAILURE"
      }
    }
  }
}
