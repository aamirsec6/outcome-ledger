# Outcome Ledger dashboard (standalone)

# Live data — Outcome Ledger API (not Authon / Agent Money)
OUTCOME_LEDGER_API_URL=http://127.0.0.1:8090
NEXT_PUBLIC_OUTCOME_LEDGER_API_URL=http://127.0.0.1:8090

# --- Multi-tenant with Clerk (recommended) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Issuer from Clerk Dashboard → API keys → Advanced → JWT Issuer
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev
# Optional: comma-separated origins for JWT aud/azp (e.g. http://localhost:3001)
CLERK_AUTHORIZED_PARTIES=http://localhost:3001

# --- Legacy single-tenant (optional) ---
# Server-only platform key — skips Clerk/cookie tenant flow when set
OUTCOME_LEDGER_API_KEY=

# Marketing landing at / (AuthOn-style). Dashboard home: /overview. Deep waitlist: /join
